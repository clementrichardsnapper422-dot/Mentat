{
  "name": "mentat-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native Windows desktop shell for the local Mentat Control UI",
  "main": "src/main-production.cjs",
  "author": "Mentat",
  "license": "MIT",
  "scripts": {
    "check": "node --check src/main.cjs && node --check src/main-production.cjs && node --check src/no-spend-command.cjs && node --check src/no-spend-cli.cjs",
    "test": "node --test test/*.test.cjs",
    "start": "electron .",
    "runtime:package": "node ../../scripts/mentat/package-windows-runtime.mjs",
    "pack": "npm run runtime:package && electron-builder --win dir --publish never",
    "dist": "npm run runtime:package && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.mentat.desktop",
    "productName": "Mentat",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.artifacts/mentat-windows-runtime/payload",
        "to": "mentat-runtime"
      },
      {
        "from": "build/install-runtime.ps1",
        "to": "mentat-installer/install-runtime.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.svg",
      "executableName": "Mentat",
      "artifactName": "Mentat-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mentat",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
